# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง
# .env ถูก gitignore ไว้ — ห้าม commit ค่าจริงลง git

# URL ของ Python vision service (best.pt) สำหรับอ่านเลขมิเตอร์
VISION_SERVICE_URL=http://127.0.0.1:8000

# ฐานข้อมูล MySQL — ใช้ร่วมกันทั้งแอป (app.module.ts), npm run migrate,
# npm run db:setup และ npm run seed:admin ชื่อฐานข้อมูลอยู่ที่นี่ที่เดียว
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=water-bill-db

# แอดมินเริ่มต้นที่ npm run seed:admin จะสร้างให้
SEED_ADMIN_EMAIL=somying@example.com
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_FNAME=สมหญิง
SEED_ADMIN_LNAME=ใจดี

# 🔐 กุญแจเซ็น JWT — สร้างค่าสุ่มของตัวเองเสมอ ห้ามใช้ค่าตัวอย่าง:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ไม่ตั้งค่านี้ แอปจะโยน error ตั้งแต่ตอน boot โดยเจตนา
JWT_SECRET=
JWT_EXPIRES_IN=1d
